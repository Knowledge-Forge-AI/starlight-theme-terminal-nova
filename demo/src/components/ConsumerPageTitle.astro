---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/PageTitle.astro';
---

<div class="consumer-page-title-wrapper" data-consumer-override="page-title">
  <Default {...Astro.props}><slot /></Default>
  <span class="consumer-override-badge">[Consumer Override Active]</span>
</div>

<style>
  .consumer-page-title-wrapper {
    position: relative;
  }
  .consumer-override-badge {
    font-size: 0.75rem;
    color: var(--sl-color-accent, #ff8a3d);
    border: 1px solid var(--sl-color-accent, #ff8a3d);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    display: inline-block;
    margin-top: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
</style>
